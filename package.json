{
  "name": "ollama-benchmark-desktop",
  "productName": "Ollama Benchmark_V2.5",
  "version": "2.5.0",
  "private": true,
  "description": "Windows desktop benchmark tool for Ollama model inference",
  "author": {
    "name": "MingSong (明松)",
    "email": "mingsong@example.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imasonhk-spec/Ollama-Benchmark-Desktop.git"
  },
  "homepage": "https://github.com/imasonhk-spec/Ollama-Benchmark-Desktop#readme",
  "bugs": {
    "url": "https://github.com/imasonhk-spec/Ollama-Benchmark-Desktop/issues"
  },
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win nsis",
    "release:minor": "npm version minor --no-git-tag-version && npm run package",
    "predev": "node scripts/sync-branding.mjs",
    "prebuild": "node scripts/sync-branding.mjs",
    "verify:package-target": "node scripts/verify-package-target.mjs"
  },
  "dependencies": {
    "docx": "latest",
    "jszip": "^3.10.1",
    "keytar": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ssh2": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ssh2": "latest",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.2.0",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "latest"
  }
}
